# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — each tool is gated on its key being set
OPENAI_API_KEY=sk-...           # enables GPT forecaster
FRED_API_KEY=...                # enables FRED economic data tool
CONGRESS_API_KEY=...            # enables congress bills tool
ODDS_API_KEY=...                # enables sports tool (the-odds-api.com)
COINGECKO_API_KEY=...           # optional, public tier works without
MENGYE_SEARCH_URL=http://...    # custom news search server

# Server
PORT=8000
LOG_LEVEL=INFO
